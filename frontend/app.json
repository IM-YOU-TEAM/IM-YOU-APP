{
  "expo": {
    "name": "I'M YOU",
    "slug": "im-u",
    "version": "1.0.0",
    "scheme": "imu",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#D0E1D1",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.movementtrackingteam.imu",
      "infoPlist": {
        "NSCameraUsageDescription": "I'M YOU uses the camera to measure your movement on this phone."
      }
    },
    "android": {
      "package": "com.movementtrackingteam.imu",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "single",
      "name": "I'M YOU",
      "backgroundColor": "#D0E1D1",
      "themeColor": "#269F86"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "I'M YOU uses the camera to measure your movement on this phone.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": true
        }
      ],
      [
        "react-native-mediapipe-posedetection",
        {
          "assetsPaths": ["./public/models/"]
        }
      ],
      "expo-video",
      "expo-web-browser"
    ]
  }
}
