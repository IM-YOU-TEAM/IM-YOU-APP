# Copy to frontend/.env and fill in from the Supabase dashboard (Project Settings -> API).
# Expo only reads .env from this folder, not the repo root. Never commit the real file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Live inference service (the PyTorch process). Vercel hosts the app; this is the machine it calls.
# Local: ws://127.0.0.1:8000   Hosted: wss://your-live-api.onrender.com
EXPO_PUBLIC_LIVE_API_URL=ws://127.0.0.1:8000
