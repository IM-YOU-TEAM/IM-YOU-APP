# Copy to .env. Supabase dashboard > Project Settings > API. Never put the secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The live model service (PyTorch). Vercel hosts the app; this is the machine it calls.
# Local: ws://127.0.0.1:8000   Hosted: wss://your-live-api.onrender.com
EXPO_PUBLIC_LIVE_API_URL=ws://127.0.0.1:8000
